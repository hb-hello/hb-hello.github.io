{%- set nav = [["/index.html", "about"], ["/timeline.html", "timeline"], ["/projects.html", "projects"], ["/resume.html", "resume"]] -%}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="dev">
    <title>{{ title }}</title>

    <!-- Pico.css -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link rel="stylesheet" href="styles/common.css">
    {%- block styles %}{% endblock %}

    <!-- Fontawesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
        integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Favicon -->
    <link rel="icon" href="assets/sea.ico" />
    {%- block scripts %}{% endblock %}
</head>

<body>

    <!-- Header -->
    <header class="nav-header">
        <nav class="navbar">
            <ul>
                {%- for href, label in nav %}
                <li><a href="{{ href }}" class="{{ 'primary' if page.url == href or (page.url == '/' and href == '/index.html') else 'secondary' }}">{{ label }}</a></li>
                {%- endfor %}
            </ul>
        </nav>
        <hr style="margin-bottom: 0;">
    </header>

    <!-- Main -->
{% block main %}{% endblock %}

    <!-- Footer -->
    <footer class="container">
        <nav>
            <ul>
                <li class="footer-icon"><a href="https://www.linkedin.com/in/hritwikbiyani/" class="secondary"><i
                            class="fa-brands fa-linkedin"></i></a></li>
                <li class="footer-icon"><a href="https://github.com/hb-hello" class="secondary"><i
                            class="fa-brands fa-github"></i></a></li>
                <li class="footer-icon"><a href="mailto:biyanihritwik@gmail.com" class="secondary"><i
                            class="fa-solid fa-envelope"></i></a></li>
            </ul>
            <ul><small>© 2026 hb-hello</small></ul>
        </nav>
    </footer>

</body>

</html>
